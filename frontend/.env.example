# Copiez en ".env" si besoin de surcharger l'URL de l'API.
# En développement (npm run dev), le proxy de vite.config.js relaie déjà
# "/api" vers http://127.0.0.1:5000 — vous n'avez RIEN à faire dans ce cas.
#
# En production (npm run build), définissez l'URL réelle de votre API Flask :
VITE_API_URL=http://localhost:5000
