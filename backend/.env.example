# Copiez ce fichier en ".env" (même dossier) et renseignez vos vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel dans Git (ajoutez-le à .gitignore).

# --- Connexion SQL Server ----------------------------------------------------
# DB_SERVER : nom d'hôte ou instance, ex "localhost", "localhost\\SQLEXPRESS",
#             "192.168.1.50", ou "monserveur.database.windows.net" (Azure SQL)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=EmpreintePointage
DB_USER=sa
DB_PASSWORD=VotreMotDePasseSQLServer
# Driver ODBC installé sur la machine (voir README pour l'installation) :
DB_DRIVER=ODBC Driver 18 for SQL Server
# En local avec un certificat auto-signé, laissez ces deux valeurs à "yes" :
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# --- Sécurité JWT -------------------------------------------------------------
# Générez une vraie valeur aléatoire, ex : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=123456789abcdef123456789abcdef
JWT_EXPIRES_SECONDS=28800

# --- Reconnaissance faciale ----------------------------------------------------
SEUIL_MIN_DEFAUT=0.45
SEUIL_MAX_DEFAUT=0.75
MODELE_RECONNAISSANCE=Facenet
DETECTOR_BACKEND=opencv

# --- CORS (origines autorisées à appeler l'API, séparées par des virgules) -----
CORS_ORIGINS=http://localhost:5173

# --- Port du serveur Flask (optionnel) ------------------------------------------
PORT=5000
